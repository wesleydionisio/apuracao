# Copie para .env na VPS
SITE_HOST=apuracao.exemplo.com.br
PUBLIC_URL=https://apuracao.exemplo.com.br
SITE_NAME=Apuração ao vivo

# gere com: openssl rand -hex 32
SECRET=troque-isto
ADMIN_TOKEN=troque-isto-tambem
POSTGRES_PASSWORD=troque-isto

# 17h de Brasília no domingo: antes disso não sai placar nem projeção, e palpites fecham aqui
RELEASE_AT=2026-10-25T17:00:00-03:00

# TSE (confirmado em 23/10): 2º turno = 6258, 1º turno = 6257
TSE_ELECTION=6258
TSE_T1=6257
POLL_INTERVAL_MS=12000
MUN_LIMIT=300
MUN_BATCH=30
# cidades que mudaram (pelo andamento por UF) buscadas por ciclo; alimenta o mapa de pontos
MUN_PER_CYCLE=150

# opcional: fixar quem é A e B (número na urna). Sem isso, segue a ordem do TSE.
# CAND_A=
# CAND_B=
# cores por número (padrão: 13 vermelho, 22 azul)
# CAND_COLORS=13:#f2202e,22:#1f6fff

# Login com o Google no chat (só quem entra manda mensagem). Client ID "Aplicativo da Web" do Google Cloud
# (APIs e serviços → Credenciais), com PUBLIC_URL em "Origens JavaScript autorizadas".
# Sem isso em produção o chat fica só leitura; em dev aparece um login de teste por e-mail.
GOOGLE_CLIENT_ID=

# Moderação do chat por modelo de decisão (OpenRouter Decisions API). Sem chave: só o filtro local.
# O plano free tem limite baixo de requisições; para domingo use o modelo pago (centavos por milhão de tokens).
OPENROUTER_API_KEY=
MOD_MODEL=inception/mercury-decide:free
# MOD_THRESHOLD=0.5   # bloqueia quando P(aceitável) < limiar
# MOD_BATCH_MS=200 MOD_MAX_BATCH=16 MOD_CONCURRENCY=4 MOD_TIMEOUT_MS=3000

# WS: operadoras com CGNAT colocam muita gente atrás do mesmo IP
IP_CONN_LIMIT=300
TRUST_PROXY=1

# alerta (infra/alert.sh)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
