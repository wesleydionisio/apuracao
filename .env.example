# Copie para .env na VPS
SITE_HOST=apuracao.exemplo.com.br
PUBLIC_URL=https://apuracao.exemplo.com.br
SITE_NAME=Apuração ao vivo

# gere com: openssl rand -hex 32
SECRET=troque-isto
ADMIN_TOKEN=troque-isto-tambem
POSTGRES_PASSWORD=troque-isto

# 17h de Brasília no domingo: antes disso não sai placar nem projeção, e palpites fecham aqui
RELEASE_AT=2026-10-25T17:00:00-03:00

# TSE (confirmado em 23/10): 2º turno = 6258, 1º turno = 6257
TSE_ELECTION=6258
TSE_T1=6257
POLL_INTERVAL_MS=12000
MUN_LIMIT=300
MUN_BATCH=30

# opcional: fixar quem é A e B (número na urna). Sem isso, segue a ordem do TSE.
# CAND_A=
# CAND_B=
# cores por número (padrão: 13 vermelho, 22 azul)
# CAND_COLORS=13:#e5484d,22:#3b82f6

# WS: operadoras com CGNAT colocam muita gente atrás do mesmo IP
IP_CONN_LIMIT=300
TRUST_PROXY=1

# alerta (infra/alert.sh)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
